{
  "name": "sih-2026-portal",
  "version": "1.0.0",
  "private": true,
  "description": "SIH 2026 - AI-Powered Academia-Industry Collaboration & Continuous Competency Platform",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "backend:dev": "npm --prefix backend start",
    "backend:start": "npm --prefix backend start",
    "backend:install": "npm --prefix backend install",
    "ai:start": "uvicorn ai_assessment_engine.main:app --reload --port 8000",
    "ai:test": "pytest ai_assessment_engine/tests/ -v",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:integration": "node integration-test.js",
    "install:all": "npm install && npm --prefix backend install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.30.0",
    "@hookform/resolvers": "3.9.1",
    "@prisma/client": "5.20.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/supabase-js": "2.46.1",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.454.0",
    "next": "14.2.16",
    "next-auth": "4.24.10",
    "react": "18",
    "react-dom": "18",
    "react-hook-form": "7.53.1",
    "recharts": "2.13.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22",
    "@types/react": "18",
    "@types/react-dom": "18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.16",
    "postcss": "^8.4.49",
    "prettier": "3.3.3",
    "prisma": "5.20.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3"
  }
}
